# =============================================================================
# Portal Cativo NewsInside_Portal — Variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env no Git. Ele está no .gitignore.
# =============================================================================

# --- Servidor do portal ---
# Porta em que o portal escuta (padrão: 8089)
PORTAL_PORT=8089

# --- Controller Omada ---
# Endpoint do controller (ex.: https://localhost:8043 ou https://omada.seudominio.com)
CONTROLLER_BASE=https://localhost:8043
# ID do controller Omada (aparece na URL da web UI após logar)
OMADAC_ID=SUA_OMADAC_ID_AQUI
# ID do site no Omada
SITE_ID=SEU_SITE_ID_AQUI

# URL pública do portal vista pelos clientes da rede (ex.: http://192.168.0.3:8089)
PORTAL_PUBLIC_BASE=http://127.0.0.1:8089

# --- Preços e limites (centavos e kbps) ---
# Preço padrão do PIX (500 = R$ 5,00)
PRICE_BRL_CENTS=500
# Preço para dispositivos Apple (2500 = R$ 25,00)
PRICE_APPLE_BRL_CENTS=2500
# Limite de taxa padrão (kbps) — 250000 = 250 Mbps
RATE_LIMIT_KBPS=250000
# Limite de taxa para Apple (kbps) — 100000 = 100 Mbps
APPLE_RATE_LIMIT_KBPS=100000
# Duração da sessão autorizada em minutos
SESSION_DURATION_MIN=60
# Retenção de logs/dados em dias (LGPD)
RETENTION_DAYS=90

# --- LivePix (PIX) ---
# Obtenha em https://livepix.gg (dashboard de desenvolvedor)
LIVEPIX_CLIENT_ID=seu_client_id_aqui
LIVEPIX_CLIENT_SECRET=seu_client_secret_aqui

# --- Autenticação Omada (hotspot operator) ---
HOTSPOT_OPERATOR=seu_operador_aqui
HOTSPOT_PASSWORD=sua_senha_aqui

# --- Usuários de teste (simulam pagamento sem PIX real) ---
# Separe por vírgula. Exemplo: Amielle,admin,teste
PORTAL_TEST_USERS=Amielle

# --- Cadastro Base do Cidadão (CBC — gov.br/Serpro) ---
# off = validação local apenas | homolog = sandbox Serpro | prod = produção
CBC_ENV=off
# Preencha apenas se contratar a API CBC (https://www.gov.br/conecta)
CBC_CLIENT_ID=
CBC_CLIENT_SECRET=
# CPF do responsável pelas consultas (header x-cpf-usuario) — obrigatório em produção
CBC_X_CPF_USUARIO=
# Se true, bloqueia cadastro quando a CBC estiver fora do ar
CBC_REQUIRED=false
